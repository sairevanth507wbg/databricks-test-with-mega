DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=

# Authentication: supply a service principal (client id + secret) OR a personal
# access token. If all are left unset, the app uses the Databricks SDK default
# auth chain (e.g. the OAuth credentials Posit Connect's Databricks integration
# injects) — this is how the QA deployment is configured.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# DATABRICKS_TOKEN=

# Catalog / schema overrides (optional; defaults shown)
# CATALOG=prd_mega
# BOOST_SCHEMA=boost
# INDICATOR_SCHEMA=indicator
