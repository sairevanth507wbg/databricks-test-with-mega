DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=

# Authentication off Connect: supply an Entra app (tenant + client id + secret)
# OR a personal access token. If all are left unset, the app uses Posit Connect's
# Service Account integration - this is how the QA deployment is configured.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# DATABRICKS_TOKEN=

# Catalog / schema overrides (optional; defaults shown)
# CATALOG=prd_mega
# BOOST_SCHEMA=boost
# INDICATOR_SCHEMA=indicator
# EXPENDITURE_SCHEMA=boost
